{
  "expo": {
    "name": "ImageRecognitionApp",
    "slug": "image-recognition-app",
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Camera permission needed for image recognition"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Photos permission needed",
          "cameraPermission": "Camera permission needed"
        }
      ]
    ]
  }
}
